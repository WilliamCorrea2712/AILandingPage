# =============================================================================
# AI Landing Page Generator — Environment Variables
# Copy this file to .env and fill in the values before running the project.
# NEVER commit the real .env file to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL 16
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For synchronous drivers (Alembic, psycopg2): postgresql://<user>:...
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_landing_pages

# -----------------------------------------------------------------------------
# REDIS — Celery broker + application cache
# Format: redis://<host>:<port>/<db_index>
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# MODEL INFERENCE
# MODEL_NAME: which open-source LLM to use for landing page generation.
#   Accepted values: llama3 | mistral | deepseek | qwen
# MODEL_PATH: absolute path inside the container where model weights are stored.
# ADAPTER_PATH: absolute path to LoRA/QLoRA adapter checkpoints.
#   Leave empty to run the base model without a fine-tuned adapter.
# -----------------------------------------------------------------------------
MODEL_NAME=llama3
MODEL_PATH=/models/weights
ADAPTER_PATH=/models/adapters

# -----------------------------------------------------------------------------
# VECTOR DATABASE — semantic search for templates and components
# VECTOR_DB_PROVIDER: qdrant | chromadb | weaviate
#   The application will refuse to start if this value is absent or invalid.
# VECTOR_DB_URL: base URL of the vector database service.
#   Qdrant default:   http://qdrant:6333
#   ChromaDB default: http://chromadb:8000
#   Weaviate default: http://weaviate:8080
# -----------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# SECURITY — JWT Authentication
# JWT_SECRET: long random string used to sign and verify JWT tokens.
#   Minimum length: 32 characters. Generate with: openssl rand -hex 32
# JWT_EXPIRY_HOURS: token lifetime in hours (1–24). Default: 24.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# SECURITY — CSRF Protection
# CSRF_SECRET: long random string used to generate and validate CSRF tokens.
#   Must be different from JWT_SECRET. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CSRF_SECRET=change-me-to-another-long-random-secret-32-chars-min

# -----------------------------------------------------------------------------
# PUBLICATION — Subdomain provisioning
# PLATFORM_DOMAIN: root domain used to build subdomains for published pages.
#   Example: plataforma.com  →  {slug}.plataforma.com
# -----------------------------------------------------------------------------
PLATFORM_DOMAIN=plataforma.com

# -----------------------------------------------------------------------------
# CLOUDFLARE — CDN and DNS management
# CLOUDFLARE_API_TOKEN: API token with DNS edit + Cache Purge permissions
#   for the zone identified by CLOUDFLARE_ZONE_ID.
#   Leave empty to disable Cloudflare integration (development only).
# CLOUDFLARE_ZONE_ID: Zone ID found in the Cloudflare dashboard.
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# -----------------------------------------------------------------------------
# GPU / PyTorch
# CUDA_VISIBLE_DEVICES: comma-separated GPU indices exposed to PyTorch.
#   Set to "" (empty) to disable GPU and run on CPU only.
# TORCH_DTYPE: floating-point precision for inference and training.
#   float16  → RTX 4090 (recommended)
#   bfloat16 → A100 / H100 (recommended)
#   float32  → CPU-only or debugging
# -----------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
TORCH_DTYPE=float16

# -----------------------------------------------------------------------------
# FRONTEND — Nuxt 3 runtime config
# NUXT_PUBLIC_API_URL: URL of the FastAPI backend reachable from the browser.
#   In development (docker-compose): http://localhost:8000
#   In production: https://api.plataforma.com
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_URL=http://localhost:8000
